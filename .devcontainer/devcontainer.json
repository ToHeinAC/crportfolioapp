{
  "name": "Crypto Portfolio App (UV)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "features": {
    "ghcr.io/astral-sh/uv:latest": {}
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "crportfolioapp.py"
      ]
    },
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": ".venv/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ]
    }
  },
  "updateContentCommand": "uv sync && echo '✅ Dependencies installed with uv'",
  "postAttachCommand": {
    "server": "uv run streamlit run crportfolioapp.py --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [8501]
}
